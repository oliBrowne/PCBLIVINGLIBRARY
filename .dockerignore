# Only pyproject.toml, README.md, LICENSE, NOTICE, MANIFEST.in, ecadlib/ and docker/ are copied into the image.
# Keep everything else (and anything secret) out of the build context.
*
!pyproject.toml
!README.md
!LICENSE
!NOTICE
!MANIFEST.in
!ecadlib
!docker/healthcheck.py
**/__pycache__
**/*.py[cod]
